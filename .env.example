# Used by docker-compose.yml (copy to .env in the repo root). Never commit the real .env.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# Optional shared secret. nginx injects it as X-API-Key, so it is NOT exposed in the JS bundle.
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# Host port nginx is published on. Use 80 on an AWS/EC2 server; 8080 is fine locally.
# HTTP_PORT=80
# Browser origin(s) allowed by CORS (only relevant if the frontend is served from another origin)
# ALLOWED_ORIGINS=http://<your-elastic-ip>
