# Used by docker-compose.yml (copy to .env in the repo root). Never commit the real .env.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# Optional shared secret. nginx injects it as X-API-Key, so it is NOT exposed in the JS bundle.
API_KEY=
RATE_LIMIT_PER_MINUTE=60
