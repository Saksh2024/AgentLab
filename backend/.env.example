# ==============================================================================
# AI Voice Agent Studio - Backend Environment Configurations
# ==============================================================================
# Copy this file to '.env' in the same folder and configure values.
#
# DO NOT commit the resulting '.env' file containing real secret keys to source control.

# Required: OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Configurations
PROJECT_NAME="AI Voice Agent Studio API"
API_V1_STR="/api/v1"
