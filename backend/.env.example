# ==============================================================================
# AI Voice Agent Studio - Backend Environment Configurations
# ==============================================================================
# Copy this file to '.env' in the same folder and configure values.
#
# DO NOT commit the resulting '.env' file containing real secret keys to source control.

# LLM Provider Configuration
# Set OPENAI_API_KEY with your OpenAI key (sk-...) or Google Gemini key
OPENAI_API_KEY=your_api_key_here

# For Google Gemini (OpenAI compatible endpoint):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# Optional Service Configurations
PROJECT_NAME="AI Voice Agent Studio API"
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="*"
# DATABASE_PATH=/path/to/persistent/agentlab.db

